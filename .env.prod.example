# ─────────────────────────────────────────────────────────────────────────────
# Production Environment Configuration Template (.env.prod.example)
# Domain: crm.musfiqdehan.com
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL 18 Production Database ───────────────────────────────────────
POSTGRES_DB=beamline_prod
POSTGRES_USER=beamline_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_HERE
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Django 6.1 + DRF 3.18 Production Backend ────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_50_CHAR_STRING
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.musfiqdehan.com,backend,localhost,127.0.0.1
BACKEND_PORT=8017

# Reverse proxy CORS & CSRF trusted origins (HTTPS only)
CORS_ALLOWED_ORIGINS=https://crm.musfiqdehan.com
CSRF_TRUSTED_ORIGINS=https://crm.musfiqdehan.com

# ── Notion Workspace Integration ─────────────────────────────────────────────
NOTION_API_KEY=your_notion_integration_token_here
NOTION_ROOT_PAGE_ID=4098194e-c3e8-811a-b5b1-c1b79f62bce1
NOTION_VERSION=2022-06-28

# ── Multi-Provider LLM Invoice Processing ────────────────────────────────────
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Email Communication Logs & SMTP Configuration ────────────────────────────
EMAIL_BACKEND=common.email_backend.AuditedEmailBackend
DEFAULT_FROM_EMAIL=ops-automation@crm.musfiqdehan.com
NOTIFICATION_RECIPIENT_EMAIL=kevin@kevinconstruction.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── n8n Production Workflow Automation ──────────────────────────────────────
N8N_HOST=crm.musfiqdehan.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_PATH=/n8n/
N8N_EDITOR_BASE_URL=https://crm.musfiqdehan.com/n8n/
WEBHOOK_URL=https://crm.musfiqdehan.com/n8n/
N8N_WEBHOOK_URL=http://n8n:5678/n8n/webhook/construction-cost-intake
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_HEX_KEY_FOR_CREDENTIAL_STORAGE
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ── Cloudflare R2 Object Storage ─────────────────────────────────────────────
R2_BUCKET_NAME=root
R2_KEY_PREFIX=beamline
R2_PUBLIC_DOMAIN=cdn.musfiqdehan.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
USE_R2_STORAGE=True

# ── Next.js 16 Production Frontend ──────────────────────────────────────────
FRONTEND_PORT=3017
BACKEND_INTERNAL_URL=http://backend:8017
NEXT_PUBLIC_API_BASE_URL=https://crm.musfiqdehan.com/api/v1
NEXT_PUBLIC_N8N_URL=https://crm.musfiqdehan.com/n8n
NEXT_PUBLIC_NOTION_HUB_URL=https://app.notion.com/p/Kevin-s-Construction-OS-4098194ec3e8811ab5b1c1b79f62bce1

