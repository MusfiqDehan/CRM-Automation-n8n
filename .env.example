# PostgreSQL 18 Configuration (Host Port: 5448)
POSTGRES_DB=kevin_construction_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5448

# Django 6.1 + DRF 3.18 Configuration (Host Port: 8017)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,host.docker.internal
BACKEND_PORT=8017
CORS_ALLOWED_ORIGINS=http://localhost:3017,http://127.0.0.1:3017,http://localhost:5678

# Notion Integration Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_ROOT_PAGE_ID=4098194e-c3e8-811a-b5b1-c1b79f62bce1
NOTION_VERSION=2022-06-28

# Optional Multi-Provider LLM Hooks (auto | deterministic | openai | gemini | deepseek)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Django Built-in Email Configuration
EMAIL_BACKEND=common.email_backend.AuditedEmailBackend
DEFAULT_FROM_EMAIL=ops-automation@kevinconstruction.com
NOTIFICATION_RECIPIENT_EMAIL=kevin@kevinconstruction.com

# n8n Configuration (Host Port: 5678)
N8N_PORT=5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/construction-cost-intake

# Next.js 16 + TypeScript 7 Configuration (Host Port: 3017)
FRONTEND_PORT=3017
BACKEND_INTERNAL_URL=http://backend:8017
NEXT_PUBLIC_API_BASE_URL=http://localhost:8017/api/v1
NEXT_PUBLIC_N8N_URL=http://localhost:5678
